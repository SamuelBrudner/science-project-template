# Pre-commit hooks. Install once:  pre-commit install && pre-commit install --hook-type commit-msg
# CI runs: pre-commit run --all-files
repos:
  - repo: https://github.com/pre-commit/pre-commit-hooks
    rev: v4.6.0
    hooks:
      - id: trailing-whitespace
      - id: end-of-file-fixer
      - id: check-yaml
      - id: check-added-large-files
        args: ["--maxkb=1024"]   # large data belongs in {{ data_versioning }}, not git

  # exploratory/ is exploration (Jupyter/marimo) — not held to library lint standards.
  - repo: https://github.com/astral-sh/ruff-pre-commit
    rev: v0.6.9
    hooks:
      - id: ruff
        args: ["--fix"]
        exclude: '^(exploratory/|docs/tutorial\.ipynb)'

  - repo: https://github.com/psf/black
    rev: 24.10.0
    hooks:
      - id: black
        exclude: '^(exploratory/|docs/tutorial\.ipynb)'

  - repo: https://github.com/pycqa/isort
    rev: 5.13.2
    hooks:
      - id: isort
        exclude: '^(exploratory/|docs/tutorial\.ipynb|workflow/scripts/)'

  - repo: https://github.com/pre-commit/mirrors-mypy
    rev: v1.13.0
    hooks:
      - id: mypy
        additional_dependencies:
          - "pydantic>=2"
          - "pydantic-settings>=2"
          - "types-PyYAML"
        files: ^src/

  - repo: https://github.com/econchick/interrogate
    rev: 1.7.0
    hooks:
      - id: interrogate
        pass_filenames: false        # check the library only, per pyproject/args
        args: ["--fail-under=90", "src"]

  # Secret scanning — blocks commits containing credentials (docs/structure.md §9)
  - repo: https://github.com/gitleaks/gitleaks
    rev: v8.21.2
    hooks:
      - id: gitleaks

  # Conventional Commits enforcement (feeds commitizen / SemVer changelog)
  - repo: https://github.com/commitizen-tools/commitizen
    rev: v3.29.1
    hooks:
      - id: commitizen
        stages: [commit-msg]

{%- if notebook_tool == "jupyter" or docs_backend == "mkdocs" %}
  # Strip .ipynb outputs before commit (clean diffs; no data/creds leak in git).
  # Runs when Jupyter is the scratch tool OR the docs backend ships an executed
  # tutorial.ipynb (mkdocs-jupyter). marimo notebooks are pure .py — nothing to
  # strip.
  - repo: https://github.com/kynan/nbstripout
    rev: 0.7.1
    hooks:
      - id: nbstripout
{%- endif %}
