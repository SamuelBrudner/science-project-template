{% if project_profile == "program_control" -%}
site_name: {{ project_name | tojson }}
theme:
  name: material
docs_dir: docs
plugins:
  - search
nav:
  - Home: index.md
  - Architecture: architecture.md
  - Operating model: operating-model.md
{% else -%}
site_name: {{ project_name | tojson }}
theme:
  name: material
docs_dir: docs
plugins:
  - search
  - mkdocs-jupyter:
      execute: true          # run docs/tutorial.ipynb at build (fail on error)
      allow_errors: false
nav:
  - Home: index.md
  - Project hub: project-hub.md
  - Tutorial: tutorial.ipynb
  - Structure: structure.md
{% endif -%}
