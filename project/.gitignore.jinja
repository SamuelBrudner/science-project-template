# --- Secrets (never commit) ---
.env
*.key
*.pem
secrets/

# --- Environment / build ---
conda_env/
__pycache__/
*.py[cod]
.mypy_cache/
.ruff_cache/
.pytest_cache/
.coverage
htmlcov/
build/
dist/
*.egg-info/
_wheel/
.snakemake/

# --- Data (versioned by {{ data_versioning }}, not git) ---
data/raw/**
data/interim/**
data/processed/**
# Re-include directories so nested DVC pointers/ignore files can be tracked.
!data/**/
{%- if data_versioning == "dvc" %}
# keep DVC pointer files and DVC-generated ignore rules
!data/raw/**/*.dvc
!data/processed/**/*.dvc
!data/raw/**/.gitignore
!data/processed/**/.gitignore
{%- endif %}
!data/**/README.md
!data/**/.gitkeep

# --- Generated outputs (regenerable build targets) ---
# Re-include directories (!results/**/) so the keep/README negations can apply.
results/**
!results/**/
!results/**/README.md
!results/**/AGENTS.md
!results/**/.gitkeep

# --- Generated theme artifacts (rendered from conf/theme by the pipeline) ---
src/{{ package_name }}/_generated/
reporting/_assets/theme-colors*.tex
# --- Resolved config artifact (regenerated from conf/) ---
results/resolved_config.yaml

# --- Reporting build artifacts ---
reporting/**/*.aux
reporting/**/*.log
reporting/**/*.out
reporting/**/*.pdf
# Frozen legacy submissions and v0.2+ deliveries are kept.
!reporting/**/submissions/**/*.pdf
!reporting/**/deliveries/**/*.pdf
reporting/**/*.synctex.gz
reporting/**/*.bbl
reporting/**/*.blg
reporting/**/*.nav
reporting/**/*.snm
reporting/**/*.toc
# Every immutable snapshot component is durable. A nested DVC-generated
# .gitignore still excludes DVC payload bytes while keeping its pointer.
!reporting/**/submissions/**
!reporting/**/deliveries/**

# --- Docs build ---
docs/_build/
site/

# --- Containers / large build artifacts ---
*.sif
container.sif

# --- OS ---
.DS_Store

# Run-registry lock (transient)
metadata/.runs.csv.lock
metadata/.runs.*.tmp
metadata/provenance/.*.tmp

# Delivery-freeze lock (transient). Staging directories are intentionally not
# ignored: DVC must be able to inspect their payload paths, and a crash-leftover
# stage should be visible to operators instead of being silently hidden.
reporting/**/.deliveries.lock
