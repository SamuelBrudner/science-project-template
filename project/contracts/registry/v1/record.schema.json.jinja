{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://example.invalid/{{ project_slug }}/contracts/registry/v1/record.schema.json",
  "title": "{{ project_name }} registry record v1",
  "x-registry-prefix": "{{ registry_prefix }}",
  "type": "object",
  "required": [
    "schema_version",
    "record_type",
    "id",
    "lifecycle_state",
    "owner_repository",
    "program_bead",
    "created_at",
    "sha256",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "const": "v1"
    },
    "record_type": {
      "enum": [
        "contract",
        "repository",
        "dataset",
        "encoder",
        "export",
        "experiment",
        "run",
        "resource"
      ]
    },
    "id": {
      "type": "string",
      "pattern": "^{{ registry_prefix }}-[a-z0-9][a-z0-9-]*$"
    },
    "lifecycle_state": {
      "enum": [
        "draft",
        "registered",
        "deprecated"
      ]
    },
    "owner_repository": {
      "type": "string",
      "pattern": "^{{ registry_prefix }}-repo-[0-9]{3}$"
    },
    "program_bead": {
      "type": "string",
      "pattern": "^{{ registry_prefix }}-[A-Za-z0-9._-]+$"
    },
    "created_at": {
      "type": "string",
      "format": "date-time",
      "pattern": "Z$"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "provenance": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": [
          "sha256"
        ],
        "properties": {
          "record_id": {
            "type": "string",
            "pattern": "^{{ registry_prefix }}-[a-z0-9][a-z0-9-]*$"
          },
          "uri": {
            "type": "string",
            "format": "uri"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "description": {
            "type": "string"
          }
        },
        "anyOf": [
          {
            "required": [
              "record_id"
            ]
          },
          {
            "required": [
              "uri"
            ]
          }
        ],
        "additionalProperties": false
      }
    },
    "references": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^{{ registry_prefix }}-[a-z0-9][a-z0-9-]*$"
      },
      "default": []
    },
    "supersedes": {
      "type": "string",
      "pattern": "^{{ registry_prefix }}-[a-z0-9][a-z0-9-]*$"
    },
    "description": {
      "type": "string"
    }
  },
  "additionalProperties": true
}
