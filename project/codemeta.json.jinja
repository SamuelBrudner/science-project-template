{
  "@context": "https://doi.org/10.5063/schema/codemeta-2.0",
  "@type": "SoftwareSourceCode",
  "name": {{ project_name | tojson }},
  "description": {{ project_description | tojson }},
  "license": "https://spdx.org/licenses/{{ license }}",
  "author": [
    {
      "@type": "Person",
      "givenName": {{ author_given | tojson }},
      "familyName": {{ author_family | tojson }}{% if orcid %},
      "@id": {{ orcid | tojson }}{% endif %}
    }
  ],
  "programmingLanguage": "Python"
}
