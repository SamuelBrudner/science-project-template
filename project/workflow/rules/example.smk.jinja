# Example stage — delete once real analysis lands. Doubles as the CI smoke test.
# Demonstrates a real manifest-driven pipeline:
#   validate manifest -> per-sample QC -> aggregate QC-passed -> figure -> provenance
# Sample wildcards and raw paths come from the validated metadata manifest.

import re
import unicodedata
from pathlib import Path

import pandas as pd

from {{ package_name }}.catalog import dataset_path, load_catalog
from metadata.path_safety import (
    ensure_real_directory,
    open_binary_no_follow,
    require_clean_dvc_outputs,
    require_regular_file,
)
from metadata.schemas import SampleRecord, validate_sample_manifest_path

# The workflow config selects a LOGICAL dataset; conf/catalog.yaml owns the path
# and format binding. This keeps CLI overrides from smuggling arbitrary paths into
# the DAG and gives notebooks, scripts, and Snakemake one dataset vocabulary.
_CATALOG_PATH = "conf/catalog.yaml"
_REPOSITORY_ROOT = Path.cwd()
require_regular_file(
    _REPOSITORY_ROOT, Path(_CATALOG_PATH), label="data catalog"
)
_CATALOG = load_catalog(_CATALOG_PATH)
_MANIFEST_KEY = config.get("sample_manifest_dataset")
if not isinstance(_MANIFEST_KEY, str) or not _MANIFEST_KEY:
    raise ValueError("workflow/config.yaml must select sample_manifest_dataset")
if _MANIFEST_KEY not in _CATALOG.datasets:
    raise KeyError(
        f"unknown sample_manifest_dataset {_MANIFEST_KEY!r}; "
        f"known catalog datasets: {sorted(_CATALOG.datasets)}"
    )
_MANIFEST_ENTRY = _CATALOG.datasets[_MANIFEST_KEY]
if _MANIFEST_ENTRY.format != "csv":
    raise ValueError(
        f"sample manifest {_MANIFEST_KEY!r} must use format 'csv', got "
        f"{_MANIFEST_ENTRY.format!r}"
    )
_MANIFEST_PATH = validate_sample_manifest_path(
    str(dataset_path(_MANIFEST_KEY, _CATALOG))
)
_MEASUREMENTS_PATH = str(dataset_path("measurements", _CATALOG))
_QC_SUMMARY_PATH = str(dataset_path("qc_summary", _CATALOG))
for _output in (_MEASUREMENTS_PATH, _QC_SUMMARY_PATH):
    ensure_real_directory(
        _REPOSITORY_ROOT,
        Path(_output).parent,
        label=f"catalog output parent for {_output}",
    )
# All-string read with NA-parsing off so schema string ids survive ("001" stays
# "001", not int 1; "NA" stays "NA").
with open_binary_no_follow(
    _REPOSITORY_ROOT, Path(_MANIFEST_PATH), label="sample manifest"
) as _manifest_handle:
    _MANIFEST_ROWS = pd.read_csv(
        _manifest_handle, dtype=str, keep_default_na=False
    ).to_dict("records")
# Validate every row BEFORE sample IDs or raw paths become Snakemake wildcards and
# inputs. The validate_metadata rule repeats the boundary and checks file existence,
# but DAG construction itself must never consume an absolute or misplaced path.
_SAMPLE_RECORDS = [SampleRecord(**row) for row in _MANIFEST_ROWS]
# Fail loud before constructing wildcard maps: sample identifiers and acquired
# files are both one-to-one experimental units, never aliases for replicates.
_SAMPLE_IDS = [record.sample_id for record in _SAMPLE_RECORDS]
_portable_ids = {}
for _sample_id in _SAMPLE_IDS:
    _portable_id = unicodedata.normalize("NFC", _sample_id).casefold()
    if _portable_id in _portable_ids:
        raise ValueError(
            f"duplicate or portable-colliding sample_id(s) in {_MANIFEST_PATH}: "
            f"{_sample_id!r} and {_portable_ids[_portable_id]!r}"
        )
    _portable_ids[_portable_id] = _sample_id

_portable_paths = {}
_physical_files = {}
for _record in _SAMPLE_RECORDS:
    _candidate = require_regular_file(
        _REPOSITORY_ROOT,
        Path(_record.file),
        label=f"raw input for sample {_record.sample_id}",
    )
    _portable_key = unicodedata.normalize("NFC", _record.file).casefold()
    if _portable_key in _portable_paths:
        raise ValueError(
            f"duplicate raw file path in {_MANIFEST_PATH}: {_record.file!r} "
            f"aliases {_portable_paths[_portable_key]!r}"
        )
    _portable_paths[_portable_key] = _record.file
    _stat = _candidate.stat(follow_symlinks=False)
    _physical_key = (_stat.st_dev, _stat.st_ino)
    if _physical_key in _physical_files:
        raise ValueError(
            f"raw inputs in {_MANIFEST_PATH} resolve to the same physical file: "
            f"{_record.file!r} and {_physical_files[_physical_key]!r}"
        )
    _physical_files[_physical_key] = _record.file
_REAL_RAW = [
    Path(record.file)
    for record in _SAMPLE_RECORDS
    if record.file.startswith("data/raw/")
]
require_clean_dvc_outputs(_REPOSITORY_ROOT, _REAL_RAW, label="real raw input")
DVC_METADATA = sorted(
    {
        metadata
        for path in _REAL_RAW
        for metadata in (
            f"{path.as_posix()}.dvc",
            f"{path.parent.as_posix()}/.gitignore",
        )
    }
)
SAMPLES = _SAMPLE_IDS
RAW = {record.sample_id: record.file for record in _SAMPLE_RECORDS}
COND = {record.sample_id: record.condition for record in _SAMPLE_RECORDS}


# Constrain {sample} to the known IDs so non-sample artifacts (e.g.
# excluded_samples.json) never match the per-sample wildcard.
wildcard_constraints:
    sample="|".join(re.escape(s) for s in SAMPLES) if SAMPLES else "$^",


rule validate_metadata:
    input:
        catalog=_CATALOG_PATH,
        manifest=_MANIFEST_PATH,
    params:
        # DAG root: a runtime OR code change re-validates too (see config.smk).
        realized_fp=_REALIZED_FP,
        code_fp=_CODE_FP,
    output:
        ok="results/qc/manifest_ok.txt",
    script:
        "../scripts/validate_metadata.py"


rule qc_sample:
    input:
        raw=lambda wc: RAW[wc.sample],
        manifest_ok="results/qc/manifest_ok.txt",
        config="results/resolved_config.yaml",
    params:
        sample=lambda wc: wc.sample,
        condition=lambda wc: COND[wc.sample],
    output:
        qc="results/qc/{sample}.json",
    script:
        "../scripts/qc_sample.py"


rule aggregate:
    input:
        qc=expand("results/qc/{s}.json", s=SAMPLES),
        config="results/resolved_config.yaml",
    output:
        table=_MEASUREMENTS_PATH,
        qc_summary=_QC_SUMMARY_PATH,
        excluded="results/qc/excluded_samples.json",
    script:
        "../scripts/aggregate.py"


rule example_figure:
    input:
        table=_MEASUREMENTS_PATH,
        config="results/resolved_config.yaml",
        mpl_light="src/{{ package_name }}/_generated/light.mplstyle",
        mpl_dark="src/{{ package_name }}/_generated/dark.mplstyle",
    output:
        light_pdf="results/figures/light/example_group_means.pdf",
        light_png="results/figures/light/example_group_means.png",
        dark_pdf="results/figures/dark/example_group_means.pdf",
        dark_png="results/figures/dark/example_group_means.png",
    script:
        "../scripts/example_figure.py"


# Cohort QC distribution — reads the FULL qc_summary (all samples, incl. QC-failed)
# so the figure shows the whole cohort: passers vs excluded, per-sample means by
# condition. A raw QC exemplar distinct from the results figure.
rule qc_distribution:
    input:
        qc_summary=_QC_SUMMARY_PATH,
        manifest=_MANIFEST_PATH,
        raw=[RAW[s] for s in SAMPLES],
        config="results/resolved_config.yaml",
        mpl_light="src/{{ package_name }}/_generated/light.mplstyle",
        mpl_dark="src/{{ package_name }}/_generated/dark.mplstyle",
    output:
        light_pdf="results/figures/light/qc_distribution.pdf",
        light_png="results/figures/light/qc_distribution.png",
        dark_pdf="results/figures/dark/qc_distribution.pdf",
        dark_png="results/figures/dark/qc_distribution.png",
    script:
        "../scripts/qc_figure.py"
