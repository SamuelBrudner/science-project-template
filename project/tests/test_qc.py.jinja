import numpy as np
import pandas as pd
import pytest

from {{ package_name }}.qc import summarize_sample, underpowered_conditions


def test_summarize_sample_pass() -> None:
    m = summarize_sample(pd.Series([1.0, 2.0, 3.0]), min_n=3)
    assert m["n"] == 3
    assert m["n_missing"] == 0
    assert m["qc_pass"] is True
    assert m["mean"] == 2.0


def test_summarize_sample_fails_below_min_n() -> None:
    assert summarize_sample(pd.Series([1.0, 2.0]), min_n=3)["qc_pass"] is False


def test_summarize_sample_missing_fails() -> None:
    m = summarize_sample(pd.Series([1.0, np.nan, 3.0]), min_n=2)
    assert m["n"] == 2
    assert m["n_missing"] == 1
    assert m["qc_pass"] is False


@pytest.mark.parametrize(
    ("values", "expected"),
    [
        ([], {"n": 0, "n_missing": 0, "mean": None, "sd": None}),
        ([5.0], {"n": 1, "n_missing": 0, "mean": 5.0, "sd": None}),
        ([np.nan], {"n": 0, "n_missing": 1, "mean": None, "sd": None}),
        (
            [np.inf, -np.inf, 2.0],
            {"n": 1, "n_missing": 2, "mean": 2.0, "sd": None},
        ),
    ],
)
def test_qc_nonfinite_edge_cases_round_trip_as_strict_json(
    values: list[float], expected: dict[str, float | int | None]
) -> None:
    """Empty/invalid statistics use null and revalidate byte semantics."""
    from metadata.schemas import SampleQC

    metrics = summarize_sample(pd.Series(values, dtype=float), min_n=1)
    for key, value in expected.items():
        assert metrics[key] == value
    record = SampleQC(sample_id="s1", condition="control", **metrics)
    encoded = record.model_dump_json()
    assert "NaN" not in encoded and "Infinity" not in encoded
    assert SampleQC.model_validate_json(encoded) == record


def test_qc_rejects_nonnumeric_measurements() -> None:
    with pytest.raises(ValueError):
        summarize_sample(pd.Series(["not-a-number"]), min_n=1)


def test_underpowered_all_pass() -> None:
    qc = pd.DataFrame(
        {"condition": ["a", "a", "b", "b"], "qc_pass": [True, True, True, True]}
    )
    assert underpowered_conditions(qc, 2) == {}


def test_underpowered_flags_short_condition() -> None:
    qc = pd.DataFrame(
        {"condition": ["a", "a", "b", "b"], "qc_pass": [True, True, True, False]}
    )
    assert underpowered_conditions(qc, 2) == {"b": 1}


def test_underpowered_all_fail() -> None:
    qc = pd.DataFrame({"condition": ["a", "b"], "qc_pass": [False, False]})
    assert underpowered_conditions(qc, 1) == {"a": 0, "b": 0}
