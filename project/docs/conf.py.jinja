"""Sphinx configuration (numpydoc + autodoc)."""

project = {{ project_name_py }}
author = {{ author_py }}
release = "0.1.0"

extensions = [
    "sphinx.ext.autodoc",
    "sphinx.ext.napoleon",
    "numpydoc",
    "myst_nb",  # executes docs/tutorial.md at build time
]
numpydoc_show_class_members = False
autodoc_typehints = "description"
html_theme = "furo"
exclude_patterns = ["_build"]

# MyST-NB: execute narrative notebooks/pages so they can't drift from the code.
source_suffix = {".rst": "restructuredtext", ".md": "myst-nb"}
nb_execution_mode = "auto"
nb_execution_raise_on_error = True  # a broken tutorial cell FAILS the docs build
